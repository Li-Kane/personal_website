# ==========================================
# Stage 1: Build React + TypeScript Frontend
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Cache package dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY . .

# Accept build-time Vite environment variables
ARG VITE_SIM_WS_URL
ARG VITE_SIM_HEALTH_URL
ARG VITE_CONTROLS_WS_URL

# Expose ARGs as ENV for Vite bundler
ENV VITE_SIM_WS_URL=${VITE_SIM_WS_URL}
ENV VITE_SIM_HEALTH_URL=${VITE_SIM_HEALTH_URL}
ENV VITE_CONTROLS_WS_URL=${VITE_CONTROLS_WS_URL}

# Compile TypeScript and bundle production assets to /app/dist
RUN npm run build

# ==========================================
# Stage 2: Serve Static Bundle via Nginx
# ==========================================
FROM nginx:stable-alpine

# SPA fallback routing
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
